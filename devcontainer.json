{
  "name": "Rafeeq Secure Municipal Agent",
  "image": "mcr.microsoft.com/vscode/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/uv:1": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Rafeeq browser demo",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "uv run rafeeq.py security-test",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true
      }
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
